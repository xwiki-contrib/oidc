<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-type" content="text/html; charset=UTF-8" />
    <title>$escapetool.xml($services.localization.render('oidc.template.logout.title'))</title>

    <style type="text/css">
      body{
        background-color: gray;
        font-family: sans-serif;
        font-size: 87.5%;
      }
      #content{
        margin: 1em auto;
        width: 80%;
        color: #4D4D4D;
        border: 1px solid #E8E8E8;
        background-color: #FFF;
        border-radius: 4px;
        box-shadow: 0px 0px 7px #E8E8E8;
        padding: 1em;
      }
    </style>
  </head>
  <body>
    <div id="content">
      ## The logout request is sent to the provider with a POST, which only the browser can produce
      <form id="oidc-logout" method="post" action="$escapetool.xml($logoutEndpoint)">
        #foreach ($parameter in $logoutParameters.entrySet())
          #foreach ($value in $parameter.value)
            <input type="hidden" name="$escapetool.xml($parameter.key)" value="$escapetool.xml($value)"/>
          #end
        #end

        ## The issuer is only known when a provider is configured
        #if ($logoutIssuer)
          #set ($logoutText = $services.localization.render('oidc.template.logout.message.provider', [$logoutIssuer]))
        #else
          #set ($logoutText = $services.localization.render('oidc.template.logout.message'))
        #end
        <p>$escapetool.xml($logoutText)</p>

        ## The form is submitted by the script below, this button is the fallback when it cannot be executed
        <input type="submit" class="button" value="$escapetool.xml($services.localization.render('oidc.template.logout.submit'))"/>
      </form>
    </div>
    <script>
      document.getElementById('oidc-logout').submit();
    </script>
  </body>
</html>
